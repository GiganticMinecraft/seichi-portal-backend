TZ=Asia/Tokyo
MYSQL_DATABASE=seichi_portal
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
DATABASE_URL=mysql://user:password@localhost:3306/seichi_portal
# Minecraft のBAN履歴を保持するDBを指定します。ローカルではデバッグ用テーブルと同じDBを使います。
MINECRAFT_BANS_DATABASE_URL=mysql://user:password@localhost:3306/seichi_portal

HTTP_PORT=9000
FRONTEND_URL=http://localhost:3000

ENV_NAME=local

REDIS_HOST=localhost
REDIS_PORT=6379

MEILISEARCH_HOST=http://localhost:7700
# 開発環境では以下の行を変更する必要はありません。
# MEILISEARCH_API_KEY=

DISCORD_BOT_TOKEN=aaaaaaaaaaaaaa

# OpenTelemetry トレーシング。OTEL_EXPORTER_OTLP_ENDPOINT 未設定なら送信は無効。
# ローカルで検証する場合は compose の otel-lgtm を起動して以下を設定する。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true

RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_ROUTING_KEY=seichi_portal
