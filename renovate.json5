{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "tracing-opentelemetry",
        "reqwest-tracing",
        "json-subscriber",
        "axum-tracing-opentelemetry"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "utoipa",
        "utoipa-axum",
        "utoipa-swagger-ui"
      ],
      "groupName": "Utoipa",
      // Renovate は同じグループ内でも major と minor の更新を分けるため、
      // 関連するクレートを互換性のあるバージョンへまとめて更新する。
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": [
        "mariadb"
      ],
      "enabled": false
    }
  ]
}
