{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "server/entrypoint/Cargo.toml"
      ],
      "matchStrings": [
        "(?<currentValue>tracing-opentelemetry-\\d+-\\d+)"
      ],
      "depNameTemplate": "tracing-opentelemetry",
      "depTypeTemplate": "features",
      "datasourceTemplate": "crate",
      // クレートのバージョンと feature 名を major/minor で比較する。feature に patch 番号は含めない。
      "versioningTemplate": "regex:^(?:tracing-opentelemetry-)?(?<major>\\d+)[.-](?<minor>\\d+)(?:\\.\\d+)?$",
      "autoReplaceStringTemplate": "tracing-opentelemetry-{{newMajor}}-{{newMinor}}"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "cargo",
        "custom.regex"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "tracing-opentelemetry",
        "reqwest-tracing",
        "json-subscriber",
        "axum-tracing-opentelemetry"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "utoipa",
        "utoipa-axum",
        "utoipa-swagger-ui"
      ],
      "groupName": "Utoipa",
      // Renovate は同じグループ内でも major と minor の更新を分けるため、
      // 関連するクレートを互換性のあるバージョンへまとめて更新する。
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": [
        "mariadb"
      ],
      "enabled": false
    }
  ]
}
