{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "tracing-opentelemetry",
        "reqwest-tracing",
        "json-subscriber",
        "axum-tracing-opentelemetry"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "utoipa",
        "utoipa-axum",
        "utoipa-swagger-ui"
      ],
      "groupName": "Utoipa"
    },
    {
      "matchPackageNames": [
        "mariadb"
      ],
      "enabled": false
    }
  ]
}
